{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/FirmaPanel/trade-country-data/main/schema/trade-group.schema.json",
  "title": "FirmaPanel trade group dataset",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "as_of_date",
    "record_count",
    "records"
  ],
  "properties": {
    "schema_version": {
      "$ref": "common.schema.json#/$defs/semanticVersion"
    },
    "as_of_date": {
      "$ref": "common.schema.json#/$defs/date"
    },
    "record_count": {
      "type": "integer",
      "minimum": 1
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/tradeGroup"
      }
    }
  },
  "$defs": {
    "tradeGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "short_name",
        "relationship_type",
        "members",
        "official_website",
        "source_ids",
        "last_verified"
      ],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "name": {
          "$ref": "common.schema.json#/$defs/nonEmptyString"
        },
        "short_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "relationship_type": {
          "enum": [
            "customs-union",
            "economic-and-political-union",
            "free-trade-area",
            "free-trade-association",
            "intergovernmental-group",
            "intergovernmental-organization",
            "international-organization",
            "trade-agreement"
          ]
        },
        "members": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "common.schema.json#/$defs/membership"
          },
          "uniqueItems": true
        },
        "official_website": {
          "$ref": "common.schema.json#/$defs/httpsUrl"
        },
        "source_ids": {
          "$ref": "common.schema.json#/$defs/sourceIds"
        },
        "last_verified": {
          "$ref": "common.schema.json#/$defs/date"
        },
        "notes": {
          "$ref": "common.schema.json#/$defs/nonEmptyString"
        }
      }
    }
  }
}
