{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/FirmaPanel/trade-country-data/main/schema/region.schema.json",
  "title": "FirmaPanel region dataset",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "as_of_date",
    "record_count",
    "records"
  ],
  "properties": {
    "schema_version": {
      "$ref": "common.schema.json#/$defs/semanticVersion"
    },
    "as_of_date": {
      "$ref": "common.schema.json#/$defs/date"
    },
    "record_count": {
      "type": "integer",
      "minimum": 1
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/region"
      }
    }
  },
  "$defs": {
    "region": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "code",
        "name",
        "parent_id",
        "level",
        "classification_system",
        "source_ids"
      ],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "code": {
          "$ref": "common.schema.json#/$defs/numericCode"
        },
        "name": {
          "$ref": "common.schema.json#/$defs/nonEmptyString"
        },
        "parent_id": {
          "oneOf": [
            {
              "$ref": "common.schema.json#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "level": {
          "enum": [
            "region",
            "subregion",
            "intermediate-region"
          ]
        },
        "classification_system": {
          "const": "UN-M49"
        },
        "source_ids": {
          "$ref": "common.schema.json#/$defs/sourceIds"
        }
      }
    }
  }
}
