{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/FirmaPanel/trade-country-data/main/schema/source.schema.json",
  "title": "FirmaPanel source registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "as_of_date",
    "record_count",
    "records"
  ],
  "properties": {
    "schema_version": {
      "$ref": "common.schema.json#/$defs/semanticVersion"
    },
    "as_of_date": {
      "$ref": "common.schema.json#/$defs/date"
    },
    "record_count": {
      "type": "integer",
      "minimum": 1
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/source"
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "authority",
        "url",
        "license",
        "license_url",
        "reuse_conditions",
        "retrieved_date",
        "last_verified",
        "normalization",
        "dataset_fields",
        "update_frequency"
      ],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "title": {
          "$ref": "common.schema.json#/$defs/nonEmptyString"
        },
        "authority": {
          "$ref": "common.schema.json#/$defs/nonEmptyString"
        },
        "url": {
          "$ref": "common.schema.json#/$defs/httpsUrl"
        },
        "license": {
          "type": [
            "string",
            "null"
          ]
        },
        "license_url": {
          "oneOf": [
            {
              "$ref": "common.schema.json#/$defs/httpsUrl"
            },
            {
              "type": "null"
            }
          ]
        },
        "reuse_conditions": {
          "$ref": "common.schema.json#/$defs/nonEmptyString"
        },
        "retrieved_date": {
          "$ref": "common.schema.json#/$defs/date"
        },
        "last_verified": {
          "$ref": "common.schema.json#/$defs/date"
        },
        "normalization": {
          "$ref": "common.schema.json#/$defs/nonEmptyString"
        },
        "dataset_fields": {
          "$ref": "common.schema.json#/$defs/stringArray"
        },
        "update_frequency": {
          "enum": [
            "annual",
            "before-release",
            "quarterly",
            "when-notified"
          ]
        }
      }
    }
  }
}
