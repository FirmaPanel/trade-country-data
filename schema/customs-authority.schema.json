{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/FirmaPanel/trade-country-data/main/schema/customs-authority.schema.json",
  "title": "FirmaPanel customs authority dataset",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "as_of_date",
    "record_count",
    "records"
  ],
  "properties": {
    "schema_version": {
      "$ref": "common.schema.json#/$defs/semanticVersion"
    },
    "as_of_date": {
      "$ref": "common.schema.json#/$defs/date"
    },
    "record_count": {
      "type": "integer",
      "minimum": 1
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/authority"
      }
    }
  },
  "$defs": {
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "country_code",
        "name",
        "authority_type",
        "website",
        "languages",
        "source_ids",
        "last_verified"
      ],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "country_code": {
          "$ref": "common.schema.json#/$defs/iso2"
        },
        "name": {
          "$ref": "common.schema.json#/$defs/nonEmptyString"
        },
        "authority_type": {
          "enum": [
            "border-and-customs-administration",
            "customs-administration",
            "tax-and-customs-authority"
          ]
        },
        "website": {
          "$ref": "common.schema.json#/$defs/httpsUrl"
        },
        "languages": {
          "$ref": "common.schema.json#/$defs/languageCodes"
        },
        "source_ids": {
          "$ref": "common.schema.json#/$defs/sourceIds"
        },
        "last_verified": {
          "$ref": "common.schema.json#/$defs/date"
        }
      }
    }
  }
}
