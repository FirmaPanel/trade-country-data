{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/FirmaPanel/trade-country-data/main/schema/common.schema.json",
  "title": "FirmaPanel Trade Country Data common definitions",
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "iso2": {
      "type": "string",
      "pattern": "^[A-Z]{2}$"
    },
    "iso3": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "numericCode": {
      "type": "string",
      "pattern": "^[0-9]{3}$"
    },
    "currencyCode": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "date": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "httpsUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "semanticVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "idArray": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/id"
      },
      "uniqueItems": true
    },
    "sourceIds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/id"
      },
      "uniqueItems": true
    },
    "stringArray": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/nonEmptyString"
      },
      "uniqueItems": true
    },
    "languageCodes": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z]{2}(?:-[A-Z]{2})?$"
      },
      "uniqueItems": true
    },
    "participant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id"
      ],
      "properties": {
        "type": {
          "enum": [
            "country",
            "trade-group"
          ]
        },
        "id": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "membership": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "status"
      ],
      "properties": {
        "type": {
          "enum": [
            "country",
            "trade-group"
          ]
        },
        "id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "status": {
          "enum": [
            "member",
            "party",
            "signatory",
            "suspended"
          ]
        },
        "effective_from": {
          "oneOf": [
            {
              "$ref": "#/$defs/date"
            },
            {
              "type": "null"
            }
          ]
        },
        "effective_to": {
          "oneOf": [
            {
              "$ref": "#/$defs/date"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
