{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/FirmaPanel/trade-country-data/main/schema/customs-relationship.schema.json",
  "title": "FirmaPanel customs relationship dataset",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "as_of_date",
    "record_count",
    "records"
  ],
  "properties": {
    "schema_version": {
      "$ref": "common.schema.json#/$defs/semanticVersion"
    },
    "as_of_date": {
      "$ref": "common.schema.json#/$defs/date"
    },
    "record_count": {
      "type": "integer",
      "minimum": 1
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/customsRelationship"
      }
    }
  },
  "$defs": {
    "customsRelationship": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "relationship_type",
        "participants",
        "status",
        "effective_from",
        "effective_to",
        "scope_note",
        "source_ids",
        "last_verified"
      ],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "name": {
          "$ref": "common.schema.json#/$defs/nonEmptyString"
        },
        "relationship_type": {
          "enum": [
            "customs-arrangement",
            "customs-union"
          ]
        },
        "participants": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "common.schema.json#/$defs/participant"
          },
          "uniqueItems": true
        },
        "status": {
          "enum": [
            "active",
            "inactive",
            "superseded"
          ]
        },
        "effective_from": {
          "oneOf": [
            {
              "$ref": "common.schema.json#/$defs/date"
            },
            {
              "type": "null"
            }
          ]
        },
        "effective_to": {
          "oneOf": [
            {
              "$ref": "common.schema.json#/$defs/date"
            },
            {
              "type": "null"
            }
          ]
        },
        "scope_note": {
          "$ref": "common.schema.json#/$defs/nonEmptyString"
        },
        "source_ids": {
          "$ref": "common.schema.json#/$defs/sourceIds"
        },
        "last_verified": {
          "$ref": "common.schema.json#/$defs/date"
        }
      }
    }
  }
}
