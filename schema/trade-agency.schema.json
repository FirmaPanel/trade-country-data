{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/FirmaPanel/trade-country-data/main/schema/trade-agency.schema.json",
  "title": "FirmaPanel trade agency dataset",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "as_of_date",
    "record_count",
    "records"
  ],
  "properties": {
    "schema_version": {
      "$ref": "common.schema.json#/$defs/semanticVersion"
    },
    "as_of_date": {
      "$ref": "common.schema.json#/$defs/date"
    },
    "record_count": {
      "type": "integer",
      "minimum": 1
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/agency"
      }
    }
  },
  "$defs": {
    "agency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "agency_type",
        "website",
        "services",
        "source_ids",
        "last_verified"
      ],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "country_code": {
          "$ref": "common.schema.json#/$defs/iso2"
        },
        "country_codes": {
          "$ref": "common.schema.json#/$defs/iso2Array"
        },
        "name": {
          "$ref": "common.schema.json#/$defs/nonEmptyString"
        },
        "agency_type": {
          "enum": [
            "export-promotion",
            "government-trade-agency",
            "investment-promotion",
            "trade-and-investment",
            "trade-promotion"
          ]
        },
        "website": {
          "$ref": "common.schema.json#/$defs/httpsUrl"
        },
        "services": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "buyer-seller-matching",
              "export-guidance",
              "investment-support",
              "market-information",
              "trade-events"
            ]
          },
          "uniqueItems": true
        },
        "source_ids": {
          "$ref": "common.schema.json#/$defs/sourceIds"
        },
        "last_verified": {
          "$ref": "common.schema.json#/$defs/date"
        }
      },
      "oneOf": [
        {
          "required": [
            "country_code"
          ],
          "not": {
            "required": [
              "country_codes"
            ]
          }
        },
        {
          "required": [
            "country_codes"
          ],
          "not": {
            "required": [
              "country_code"
            ]
          }
        }
      ]
    }
  }
}
